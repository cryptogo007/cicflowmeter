<span>            bpf_map_update_elem(map_fd, &amp;key, &amp;value, BPF_ANY=
);</span>
<span></span>
<span>            // If new verdict is BLOCK and flow was active, inject RS=
T</span>
<span>            if (rule.action =3D=3D VERDICT_DROP &amp;&amp; flow_was_a=
ctive) {</span>
<span>                rst_injector-&gt;InjectBidirectionalRST(rule);</span>
<span>            }</span>
<span></span>
<span>            // Publish metric</span>
<span>            enforcement_counter.Increment(rule.action);</span>
<span>        }</span>
<span>    }</span>
