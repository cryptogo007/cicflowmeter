</span>
<span>    // Get the map file descriptor</span>
<span>    int map_fd =3D bpf_object__find_map_fd_by_name(obj, "verdict_map"=
);</span>
<span></span>
<span>    // 3. Stale Entry Sweeper (runs every 5 seconds)</span>
<span>    std::thread sweeper([&amp;]() {</span>
<span>        while (running) {</span>
<span>            Sleep(5000);</span>
<span>            __u64 now =3D GetMonotonicNs();</span>
<span>            // Walk all map entries, delete expired ones</span>
<span>            bpf_map_for_each(map_fd, [&amp;](void *key, void *value) =
{</span>
<span>                auto *v =3D (verdict_value *)value;</span>
<span>                if (now &gt; v-&gt;expiry_ns) {</span>
<span>                    bpf_map_delete_elem(map_fd, key);</span>
<span>                }</span>
<span>            });</span>
<span>        }</span>
<span>    });</span>
<span></span>
<span>    // 4. Main loop: consume verdicts from Layer 5</span>
<span>    while (running) {</span>
<span>        WaitForSingleObject(ready_sem, 100ms);</span>
<span></span>
<span>        FastPathRuleEntry rule;</span>
<span>        while (rule_queue-&gt;try_pop(rule)) {</span>
