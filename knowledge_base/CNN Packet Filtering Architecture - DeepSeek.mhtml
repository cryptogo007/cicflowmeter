nt"><span class=3D"code-info-button-text">Download</span></span></div></div=
></div></div></div></div><pre><span>while (service_running) {</span>
<span>    flow =3D work_queue.pop();</span>
<span></span>
<span>    if (flow.packet_count &lt; MinPacketsForValidTensor) {</span>
<span>        // Log and skip, or construct zero-padded tensor with a flag<=
/span>
<span>        continue;</span>
<span>    }</span>
<span></span>
<span>    // =3D=3D=3D STEP 1: Temporal Normalization =3D=3D=3D</span>
<span>    // Divide the flow's duration into GridHeight equal time bins.</s=
pan>
<span>    duration =3D flow.last_timestamp - flow.first_timestamp;</span>
<span>    if (duration =3D=3D 0) duration =3D 1ns;</span>
<span>    bin_width =3D duration / GridHeight;</span>
<span></span>
<span>    // Initialize 4 channels, each as a 32x32 float array (zero-fille=
d)</span>
<span>    Tensor4D tensor(GridHeight, GridWidth, ChannelCount); // All zero=
s</span>
<span></span>
<span>    // =3D=3D=3D STEP 2: Per-Packet Bin Assignment =3D=3D=3D</span>
<span>    // Each packet is assigned to exactly one time bin based on its t=
imestamp.</span>
<span>    // Packets in the same bin will be aggregated together.</span>
<span>    vector&lt;vector&lt;PacketMeta&gt;&gt; bins(GridHeight);</span>
<span>    for each packet in flow.packets {</span>
<span>        bin_idx =3D (packet.timestamp - flow.first_timestamp) / bin_w=
idth;</span>
<span>        if (bin_idx &gt;=3D GridHeight) bin_idx =3D GridHeight - 1; /=
/ Clamp</span>
<span>        bins[bin_idx].push_back(packet);</span>
<span>    }</span>
<span></span>
<span>    // =3D=3D=3D STEP 3: Per-Bin Channel Computation =3D=3D=3D</span>
<span>    for bin_idx =3D 0 to GridHeight-1 {</span>
<span>        if (bins[bin_idx].empty()) {</span>
<span>            // Leave as zeros. Zero rows indicate silence/absence.</s=
pan>
<span>            continue;</span>
<span>        }</span>
<span></span>
<span>        // --- Channel 0: Packet Size Distribution ---</span>
<span>        // Sort packet lengths in this bin, then sample at 32 percent=
iles.</span>
<span>        sort(bins[bin_idx].lengths);</span>
<span>        for col =3D 0 to 31 {</span>
<span>            percentile =3D col / 31.0; // 0.0 to 1.0</span>
<span>            idx =3D percentile * (bins[bin_idx].count - 1);</span>
<span>            tensor(bin_idx, col, 0) =3D bins[bin_idx].lengths[idx];</=
span>
<span>        }</span>
<span></span>
<span>        // --- Channel 1: IAT Spectrum ---</span>
<span>        // Compute inter-arrival times between consecutive packets in=
 this bin.</span>
<span>        iats =3D compute_iats(bins[bin_idx]); // Array of deltas</spa=
n>
<span>        if (iats.size() &gt;=3D 2) {</span>
<span>            // 32-point FFT on the IAT sequence (zero-padded if neede=
d)</span>
<span>            spectrum =3D fft_rtof(iats, 32); // Real-to-complex FFT v=
ia MKL</span>
<span>            for col =3D 0 to 31 {</span>
<span>                // Magnitude of frequency component, log-scaled</span=
>
<span>                tensor(bin_idx, col, 1) =3D log1p(abs(spectrum[col]))=
;</span>
<span>            }</span>
<span>        }</span>
<span></span>
<span>        // --- Channel 2: Directional Flow Matrix ---</span>
<span>        // Count inbound vs outbound packets in this bin.</span>
<span>        inbound_ratio =3D count_inbound(bins[bin_idx]) / bins[bin_idx=
].count;</span>
<span>        outbound_ratio =3D 1.0 - inbound_ratio;</span>
<span>        // Smoothly interpolate across 32 columns</span>
<span>        for col =3D 0 to 31 {</span>
<span>            weight =3D col / 31.0; // 0=3Dfully inbound, 31=3Dfully o=
utbound</span>
<span>            tensor(bin_idx, col, 2) =3D (1-weight)*inbound_ratio + we=
ight*outbound_ratio;</span>
<span>        }</span>
<span></span>
<span>        // --- Channel 3: Entropy &amp; Control Matrix ---</span>
<span>        // Column 0: Packet size entropy</span>
<span>        tensor(bin_idx, 0, 3) =3D shannon_entropy(bins[bin_idx].lengt=
hs);</span>
<span>        // Column 1: IAT entropy</span>
<span>        tensor(bin_idx, 1, 3) =3D shannon_entropy(iats);</span>
<span>        // Column 2: TCP flag distribution entropy</span>
<span>        tensor(bin_idx, 2, 3) =3D shannon_entropy(bins[bin_idx].tcp_f=
lags);</span>
<span>        // Columns 3-31: Higher-order statistical moments (skewness, =
kurtosis) of sizes</span>
<span>        tensor(bin_idx, 3..31, 3) =3D higher_moments(bins[bin_idx].le=
ngths);</span>
<span>    }</span>
<span></span>
<span>    // =3D=3D=3D STEP 4: Global Normalization (Z-Score) =3D=3D=3D</sp=
an>
<span>    // Normalize each channel independently across the entire 32x32 g=
rid.</span>
<span>    // This prevents magnitude differences between channels from bias=
ing the CNN.</span>
<span>    for channel =3D 0 to 3 {</span>
<span>        mean =3D mean_of_channel(tensor, channel);</span>
<span>        stddev =3D stddev_of_channel(tensor, channel);</span>
<span>        if (stddev &lt; EPSILON) stddev =3D 1.0; // Avoid division by=
 zero</span>
<span>        for all (x,y) in grid {</span>
<span>            tensor(x, y, channel) =3D (tensor(x, y, channel) - mean) =
/ stddev;</span>
<span>        }</span>
<span>    }</span>
<span></span>
<span>    // =3D=3D=3D STEP 5: Enqueue for Export =3D=3D=3D</span>
<span>    export_queue.push({flow.flow_key, tensor});</span>
<span>}</span></pre><svg xmlns=3D"http://www.w3.org/2000/svg" width=3D"12" =
