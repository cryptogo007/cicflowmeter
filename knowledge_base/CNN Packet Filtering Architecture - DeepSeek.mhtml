<span></span>
<span>        auto flat_flow =3D CreateFlowRecordFlat(builder, meta, packet=
s_vec,</span>
<span>            flow_snapshot.bytes_in, flow_snapshot.bytes_out,</span>
<span>            flow_snapshot.duration, flow_snapshot.packet_count_total)=
;</span>
<span></span>
<span>        builder.Finish(flat_flow);</span>
<span></span>
<span>        // 2. Write to output shared memory</span>
<span>        output_shm.write(builder.GetBufferPointer(), builder.GetSize(=
