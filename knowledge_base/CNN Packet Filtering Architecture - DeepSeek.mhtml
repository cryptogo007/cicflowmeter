re><span>while (service_running) {</span>
<span>    EnrichedVerdict ctx =3D evaluation_queue.pop();</span>
<span></span>
<span>    // Acquire a shared_ptr to the current rule set (lock-free read)<=
/span>
<span>    auto rules =3D current_rule_set.load();</span>
<span></span>
<span>    FinalAction final_action;</span>
<span>    final_action.flow_id =3D ctx.cnn.flow_id;</span>
<span>    final_action.primary_action =3D ALLOW; // Default</span>
<span></span>
<span>    // Evaluate rules in priority order</span>
<span>    for (const auto&amp; rule : *rules) {</span>
<span>        // Skip disabled rules</span>
<span>        if (!rule.enabled) continue;</span>
<span></span>
<span>        // Skip rules not matching flow protocol (fast pre-filter)</s=
pan>
<span>        if (rule.HasProtocolFilter() &amp;&amp; !rule.MatchesProtocol=
(ctx.flow_metadata.protocol)) {</span>
<span>            continue;</span>
<span>        }</span>
<span></span>
<span>        // Evaluate the full condition tree</span>
<span>        EvaluationResult eval =3D EvaluateConditionTree(rule.conditio=
ns, ctx);</span>
<span></span>
<span>        if (eval.is_match) {</span>
<span>            // Rule matched. Determine action.</span>
<span>            final_action.primary_action =3D ParseAction(rule.actions.=
primary);</span>
<span>            final_action.matched_rule_id =3D rule.rule_id;</span>
<span>            final_action.matched_rule_name =3D rule.rule_name;</span>
<span>            final_action.block_method =3D rule.actions.block_method;<=
/span>
<span>            final_action.quarantine_vlan =3D rule.actions.quarantine.=
enabled ?</span>
<span>                                            rule.actions.quarantine.v=
lan_reassign : 0;</span>
<span>            final_action.soc_alert =3D rule.actions.notifications.soc=
_alert;</span>
<span>            final_action.alert_severity =3D rule.actions.notification=
s.alert_severity;</span>
<span>            final_action.mitre_technique =3D rule.metadata.mitre_tech=
nique;</span>
<span>            final_action.evaluation_timestamp_us =3D GetTimestamp();<=
/span>
<span></span>
<span>            // If rule is "first-match-wins" (high priority), stop ev=
aluation</span>
<span>            if (rule.priority &gt;=3D 90) {</span>
<span>                break; // Critical rules preempt lower-priority rules=
</span>
<span>            }</span>
<span>            // Otherwise, continue evaluating. Lower priority rules c=
an add supplementary</span>
<span>            // actions (e.g., additional logging) but cannot override=
 a BLOCK with ALLOW.</span>
<span>        }</span>
<span>    }</span>
<span></span>
<span>    // If no rule matched, final_action remains ALLOW with no special=
 handling.</span>
<span></span>
<span>    // Push to action dispatcher</span>
<span>    action_queue.push(std::move(final_action));</span>
<span>}</span></pre><svg xmlns=3D"http://www.w3.org/2000/svg" width=3D"12" =
