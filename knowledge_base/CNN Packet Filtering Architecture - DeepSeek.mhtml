<span>    Sleep(500ms);</span>
<span>    now =3D current_time;</span>
<span></span>
<span>    // Identify the bucket that represents [now - 15 seconds]</span>
<span>    expired_bucket =3D timing_wheel.get_bucket(now - IDLE_TIMEOUT);</=
span>
<span></span>
<span>    for each flow_key in expired_bucket {</span>
<span>        accessor acc;</span>
<span>        if (flow_table.find(acc, flow_key)) {</span>
<span>            flow_record =3D &amp;acc-&gt;second;</span>
<span>            flow_record-&gt;lock();</span>
<span></span>
<span>            // Re-verify: flow might have been updated just after buc=
ket roll</span>
<span>            if ((now - flow_record-&gt;last_seen) &gt;=3D IDLE_TIMEOU=
T) {</span>
<span>                // 1. Finalize the flow record</span>
<span>                flow_record-&gt;is_closed =3D true;</span>
<span>                flow_record-&gt;duration =3D flow_record-&gt;last_see=
n - flow_record-&gt;first_seen;</span>
<span></span>
<span>                // 2. Push a copy into the export queue</span>
<span>                export_queue.push(flow_record-&gt;snapshot());</span>
<span></span>
<span>                // 3. Remove from flow table</span>
<span>                flow_table.erase(acc);</span>
<span>            }</span>
<span></span>
<span>            flow_record-&gt;unlock();</span>
<span>        }</span>
<span>    }</span>
<span>}</span></pre><svg xmlns=3D"http://www.w3.org/2000/svg" width=3D"12" =
