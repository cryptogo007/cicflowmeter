></div></div></div></div><pre><span>EvaluationResult EvaluateConditionTree(=
const ConditionNode&amp; node, const EnrichedVerdict&amp; ctx) {</span>
<span>    if (node.is_leaf) {</span>
<span>        // Evaluate a single predicate</span>
<span>        return EvaluatePredicate(node.predicate, ctx);</span>
<span>    }</span>
<span></span>
<span>    // Internal node: combine children</span>
<span>    std::vector&lt;EvaluationResult&gt; child_results;</span>
<span>    for (const auto&amp; child : node.children) {</span>
<span>        child_results.push_back(EvaluateConditionTree(child, ctx));</=
span>
<span>    }</span>
<span></span>
<span>    if (node.logical_operator =3D=3D AND) {</span>
<span>        bool all_true =3D std::all_of(child_results.begin(), child_re=
sults.end(),</span>
<span>            [](auto&amp; r) { return r.is_match; });</span>
<span>        return {all_true, CombineMatchDetails(child_results)};</span>
<span>    } else { // OR</span>
<span>        bool any_true =3D std::any_of(child_results.begin(), child_re=
sults.end(),</span>
<span>            [](auto&amp; r) { return r.is_match; });</span>
<span>        return {any_true, CombineMatchDetails(child_results)};</span>
<span>    }</span>
<span>}</span>
<span></span>
<span>EvaluationResult EvaluatePredicate(const Predicate&amp; pred, const E=
nrichedVerdict&amp; ctx) {</span>
<span>    // Extract the field value from the context</span>
<span>    FieldValue actual =3D ExtractField(ctx, pred.field);</span>
<span></span>
<span>    // Apply the operator</span>
<span>    switch (pred.operator_type) {</span>
<span>        case EQUALS:</span>
<span>            return {actual =3D=3D pred.value};</span>
<span>        case GREATER_THAN_OR_EQUAL:</span>
<span>            return {actual.AsFloat() &gt;=3D pred.value.AsFloat()};</=
span>
<span>        case IN_LIST:</span>
<span>            return {pred.value_list.Contains(actual)};</span>
<span>        case REGEX_MATCH:</span>
<span>            return {RE2::FullMatch(actual.AsString(), pred.regex_patt=
ern)};</span>
<span>        case IP_IN_SUBNET:</span>
<span>            return {IsIPInSubnet(actual.AsIP(), pred.value.AsCIDR())}=
;</span>
<span>        // ... additional operators</span>
<span>    }</span>
<span>}</span></pre><svg xmlns=3D"http://www.w3.org/2000/svg" width=3D"12" =
