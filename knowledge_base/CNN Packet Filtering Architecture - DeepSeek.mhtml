</div></div></div><pre><span>while (service_running) {</span>
<span>    FinalAction action =3D action_queue.pop();</span>
<span></span>
<span>    // 1. Write to Fast Path shared memory (Layer 6)</span>
<span>    FastPathRuleEntry fp_entry;</span>
<span>    fp_entry.flow_key =3D BuildFlowKey(action.flow_id);</span>
<span>    fp_entry.action =3D (action.primary_action =3D=3D BLOCK) ? ACTION=
_DROP : ACTION_ALLOW;</span>
<span>    fp_entry.block_method =3D action.block_method;</span>
<span>    fp_entry.expiry_epoch_sec =3D NowSeconds() + FLOW_TIMEOUT_SECONDS=
;</span>
<span>    fp_entry.quarantine_vlan =3D action.quarantine_vlan;</span>
<span></span>
<span>    fastpath_shm-&gt;Write(fp_entry);</span>
<span>    ReleaseSemaphore(FastPathRuleReady_Sem, 1, NULL);</span>
<span></span>
<span>    // 2. Audit Log (JSON line to file + SIEM)</span>
<span>    json audit;</span>
<span>    audit["timestamp"] =3D ISO8601(Now());</span>
<span>    audit["flow_id"] =3D action.flow_id;</span>
<span>    audit["verdict"] =3D action.primary_action =3D=3D BLOCK ? "BLOCK"=
 : "ALLOW";</span>
<span>    audit["matched_rule"] =3D action.matched_rule_id;</span>
<span>    audit["matched_rule_name"] =3D action.matched_rule_name;</span>
<span>    audit["severity"] =3D action.alert_severity;</span>
<span>    audit["mitre_technique"] =3D action.mitre_technique;</span>
<span>    audit["block_method"] =3D action.block_method;</span>
<span>    audit["evaluation_latency_us"] =3D action.evaluation_timestamp_us=
;</span>
<span></span>
<span>    spdlog::get("audit")-&gt;info(audit.dump());</span>
<span></span>
<span>    // 3. SIEM Forwarding (Syslog or Kafka)</span>
<span>    if (action.soc_alert) {</span>
<span>        siem_producer-&gt;Send(audit.dump());</span>
<span>    }</span>
<span></span>
<span>    // 4. Notification (Email, PagerDuty, Teams Webhook)</span>
<span>    if (action.alert_severity =3D=3D "CRITICAL") {</span>
<span>        notification_engine-&gt;SendCriticalAlert(action);</span>
<span>    }</span>
<span></span>
<span>    // 5. Prometheus metrics</span>
<span>    verdict_counter.WithLabelValues(</span>
<span>        action.primary_action =3D=3D BLOCK ? "block" : "allow",</span=
>
<span>        action.matched_rule_id</span>
<span>    ).Increment();</span>
<span>}</span></pre><svg xmlns=3D"http://www.w3.org/2000/svg" width=3D"12" =
