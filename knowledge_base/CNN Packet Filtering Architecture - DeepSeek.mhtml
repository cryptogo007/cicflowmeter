<span>            bpf_map_lookup_elem(map_fd, &amp;key, &amp;existing);</sp=
an>
<span></span>
<span>            bool flow_was_active =3D false;</span>
<span>            if (existing) {</span>
<span>                __u64 now =3D GetMonotonicNs();</span>
