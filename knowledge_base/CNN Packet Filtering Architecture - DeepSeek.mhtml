<span>            flow_snapshot.src_port, flow_snapshot.dst_port,</span>
<span>            flow_snapshot.protocol, flow_snapshot.vlan_id);</span>
<span>        auto packets_vec =3D builder.CreateVectorOfStructs(</span>
<span>            flow_snapshot.packet_descriptors, flow_snapshot.packet_co=
