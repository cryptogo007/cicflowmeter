an>
<span>    std::vector&lt;torch::Tensor&gt; activations, gradients;</span>
<span>    conv_layer-&gt;register_forward_hook([&amp;](auto m, auto inp, au=
to out) {</span>
<span>        activations.push_back(out);</span>
<span>    });</span>
<span>    conv_layer-&gt;register_backward_hook([&amp;](auto m, auto ginp, =
auto gout) {</span>
<span>        gradients.push_back(gout[0]);</span>
<span>    });</span>
<span></span>
<span>    // 2. Forward pass (single tensor, not batch) to get Head A predi=
ction</span>
<span>    auto input =3D xai_request.tensor.unsqueeze(0).to(torch::kCUDA);<=
/span>
<span>    input.requires_grad_(true);</span>
<span>    auto output =3D model-&gt;run_method("forward_head_a",</span>
<span>                    model-&gt;run_method("forward_backbone", input));=
</span>
<span></span>
<span>    // 3. Backward pass on the predicted class score</span>
<span>    auto target_class =3D output.argmax();</span>
<span>    model-&gt;zero_grad();</span>
<span>    output[0][target_class].backward();</span>
<span></span>
<span>    // 4. Compute Grad-CAM</span>
<span>    // Grad-CAM =3D ReLU( sum_k( alpha_k * A_k ) )</span>
<span>    // where alpha_k =3D global_average_pool(gradient_k)</span>
<span>    auto pooled_grads =3D gradients[0].mean({2, 3}, true); // [1, C, =
1, 1]</span>
