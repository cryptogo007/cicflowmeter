<span></span>
<span>    // Batch drain: read up to 64 packet descriptors from the ring bu=
ffer</span>
<span>    packets =3D ring_buffer-&gt;read_batch(64);</span>
<span></span>
<span>    for each packet in packets {</span>
<span>        // 1. Extract 5-tuple + VLAN from raw bytes</span>
<span>        // Offsets are fixed: EtherType at byte 12, IP header at 14, =
etc.</span>
<span>        // We perform a shallow parse: only L2 (MAC), L3 (IP), L4 (TC=
P/UDP).</span>
<span>        flow_key =3D extract_flow_key(packet.data);</span>
<span></span>
<span>        // 2. Hash the flow key to determine which Worker thread owns=
 this flow</span>
<span>        worker_id =3D hash(flow_key) % N_WORKERS;</span>
<span></span>
<span>        // 3. Push packet reference into that worker's lock-free SPSC=
 queue</span>
<span>        worker_input_queue[worker_id].push(packet_descriptor);</span>
<span>    }</span>
<span></span>
<span>    // Signal workers that new packets are available</span>
<span>    for i in 0..N_WORKERS:</span>
<span>        worker_signal_event[i].Set();</span>
<span></span>
<span>    // Return slots to Layer 1</span>
<span>    ring_buffer-&gt;release_slots(packets.count);</span>
<span>}</span></pre><svg xmlns=3D"http://www.w3.org/2000/svg" width=3D"12" =
