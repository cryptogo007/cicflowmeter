<span></span>
<span>while (service_running) {</span>
<span>    WaitForSingleObject(TensorReady_Sem, remaining_time_to_deadline);=
</span>
<span></span>
<span>    tensor =3D input_shm.read_one();</span>
<span></span>
<span>    // Convert protobuf float array to LibTorch tensor [1, 4, 32, 32]=
</span>
<span>    torch_tensor =3D torch::from_blob(tensor.data, {1, 4, 32, 32});</=
