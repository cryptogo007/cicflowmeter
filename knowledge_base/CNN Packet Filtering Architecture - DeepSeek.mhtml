n>while (service_running) {</span>
<span>    WaitForSingleObject(worker_signal_event, 10ms);</span>
<span></span>
<span>    while (packet =3D worker_input_queue[my_id].pop()) {</span>
<span>        // 1. Lookup or Create Flow Record</span>
<span>        flow_key =3D extract_flow_key(packet);</span>
<span>        accessor acc; // TBB accessor for fine-grained locking</span>
<span>        if (!flow_table.find(acc, flow_key)) {</span>
<span>            // Insert new flow</span>
<span>            flow_table.insert(acc, flow_key);</span>
<span>            flow_record =3D &amp;acc-&gt;second;</span>
<span>            flow_record.init(flow_key, current_time);</span>
<span>        } else {</span>
<span>            flow_record =3D &amp;acc-&gt;second;</span>
<span>        }</span>
<span></span>
<span>        // 2. Lock the flow record for exclusive update (very short d=
uration)</span>
<span>        flow_record-&gt;lock();</span>
<span></span>
<span>        // 3. Update Flow Telemetry</span>
<span>        flow_record-&gt;last_seen =3D current_time;</span>
<span>        flow_record-&gt;packet_count_total++;</span>
<span>        flow_record-&gt;byte_count_total +=3D packet.length;</span>
<span></span>
<span>        // 4. Store Packet Metadata in Circular Buffer (fixed-size, p=
re-allocated)</span>
<span>        pkt_slot =3D &amp;flow_record-&gt;packet_buffer[flow_record-&=
gt;buffer_index % 256];</span>
<span>        pkt_slot-&gt;timestamp =3D packet.timestamp;</span>
<span>        pkt_slot-&gt;direction =3D (packet.src_ip =3D=3D flow_key.src=
_ip) ? OUTBOUND : INBOUND;</span>
<span>        pkt_slot-&gt;length =3D packet.length;</span>
<span>        pkt_slot-&gt;tcp_flags =3D extract_tcp_flags(packet); // SYN,=
 ACK, FIN, RST, PSH</span>
<span>        pkt_slot-&gt;ip_ttl =3D extract_ip_ttl(packet);</span>
<span>        flow_record-&gt;buffer_index++;</span>
<span></span>
<span>        // 5. Update Aggregate Metadata Counters</span>
<span>        if (pkt_slot-&gt;tcp_flags &amp; SYN) flow_record-&gt;syn_cou=
nt++;</span>
<span>        if (pkt_slot-&gt;direction =3D=3D INBOUND) {</span>
<span>            flow_record-&gt;bytes_in +=3D packet.length;</span>
<span>        } else {</span>
<span>            flow_record-&gt;bytes_out +=3D packet.length;</span>
<span>        }</span>
<span></span>
<span>        // 6. Update Timing Wheel Pointer</span>
<span>        timing_wheel.update(flow_key, current_time);</span>
<span></span>
<span>        flow_record-&gt;unlock();</span>
<span>    }</span>
<span>}</span></pre><svg xmlns=3D"http://www.w3.org/2000/svg" width=3D"12" =
