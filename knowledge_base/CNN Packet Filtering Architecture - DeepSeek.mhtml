<span></span>
<span>    // Create enriched context object</span>
<span>    EnrichedVerdict ctx;</span>
<span>    ctx.cnn =3D cnn_verdict;</span>
<span>    ctx.flow_metadata =3D ExtractFlowMetadata(cnn_verdict.flow_id);</=
span>
<span></span>
<span>    // --- Context Enrichment Pipeline ---</span>
<span></span>
<span>    // 1. Asset Lookup (source and destination)</span>
<span>    ctx.src_asset =3D AssetLookup(ctx.flow_metadata.src_ip);</span>
<span>    ctx.dst_asset =3D AssetLookup(ctx.flow_metadata.dst_ip);</span>
<span></span>
<span>    // 2. Threat Intelligence Lookup</span>
<span>    ctx.dst_threat =3D ThreatLookup(ctx.flow_metadata.dst_ip);</span>
<span>    if (ctx.flow_metadata.tls_sni.has_value()) {</span>
<span>        ctx.domain_threat =3D ThreatLookup(ctx.flow_metadata.tls_sni.=
value());</span>
<span>    }</span>
<span></span>
<span>    // 3. Geolocation</span>
<span>    ctx.dst_geo =3D GeoLookup(ctx.flow_metadata.dst_ip);</span>
<span></span>
<span>    // 4. User Identity (if source is internal)</span>
<span>    if (IsInternalIP(ctx.flow_metadata.src_ip)) {</span>
<span>        ctx.src_user =3D LDAPLookup(ctx.flow_metadata.src_ip);</span>
<span>    }</span>
<span></span>
<span>    // 5. Time Context</span>
<span>    ctx.timestamp =3D std::chrono::system_clock::now();</span>
<span>    ctx.hour_of_day =3D GetHourOfDay(ctx.timestamp);</span>
<span>    ctx.day_of_week =3D GetDayOfWeek(ctx.timestamp);</span>
<span>    ctx.is_business_hours =3D IsBusinessHours(ctx.timestamp);</span>
<span></span>
<span>    // Push to evaluation queue</span>
<span>    evaluation_queue.push(std::move(ctx));</span>
<span>}</span></pre><svg xmlns=3D"http://www.w3.org/2000/svg" width=3D"12" =
